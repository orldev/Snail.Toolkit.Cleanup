<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central package management with more than one feed configured requires an explicit mapping (NU1507); without it a
    public package can shadow a private one of the same name. Sources stay in the user-level configuration; only the
    routing is pinned here. Until Snail.Sdk is on NuGet its packages come from the local feed: the longer pattern wins,
    so Snail.Sdk.* resolves there and everything else on nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalPackages">
      <package pattern="Snail.Sdk" />
      <package pattern="Snail.Sdk.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
